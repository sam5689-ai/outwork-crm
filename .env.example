DATABASE_URL="postgresql://user:password@localhost:5432/outwork_crm?schema=public"

# NextAuth - generate a secret with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Gmail + Calendar/Meet integration)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable the Gmail API and Google Calendar API, add an OAuth Client ID (Web application),
# and add GOOGLE_REDIRECT_URI to the "Authorized redirect URIs" list.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Seed script - initial admin account
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
