// Outwork CRM data model
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum ClientStage {
  INTERESTED
  CANDIDATE_MATCHED
  CONTRACT_SIGNED
  TRIAL_PASSED
  LOST
}

enum CandidateStage {
  SOURCED
  SUITABLE
  MATCHED
  ACCEPTED
  REJECTED
}

enum JobStage {
  OPEN
  MATCHING
  CLIENT_REVIEW
  SCHEDULED
  FILLED_WON
  CANCELLED_LOST
}

enum MatchStatus {
  SUGGESTED
  OUTREACHED
  CLIENT_REVIEW
  SCHEDULED
  PLACED
  REJECTED
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailFolder {
  INBOX
  SENT
  ARCHIVE
  TRASH
  DRAFT
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contacts      Contact[]      @relation("ContactOwner")
  activities    Activity[]
  googleAccount GoogleAccount?
  syncedEmails  EmailMessage[]
}

model GoogleAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail  String
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  scope        String?
  expiresAt    DateTime?
  connectedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  company   String?
  notes     String?  @db.Text
  ownerId   String
  owner     User     @relation("ContactOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     Client?
  candidate  Candidate?
  emails     EmailMessage[]
  meetings   Meeting[]
  activities Activity[]

  @@index([ownerId])
  @@index([email])
}

model Client {
  id          String      @id @default(cuid())
  contactId   String      @unique
  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  name        String
  stage       ClientStage @default(INTERESTED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  email          String?
  website        String?
  industry       String?
  employeeCount  Int?
  workHours      String?
  payRate        Float?
  payUnit        String   @default("hourly")

  street  String?
  city    String?
  state   String?
  zipCode String?
  country String? @default("US")

  jobs Job[]

  @@index([stage])
}

model Job {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  stage       JobStage @default(OPEN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  openingsCount   Int      @default(1)
  startDate       DateTime?
  workHours       String?
  billRate        Float?
  targetPayRate   Float?
  requiredSkills  String[] @default([])

  // Set when the job enters FILLED_WON / CANCELLED_LOST, cleared if it's
  // re-opened. These drive "jobs filled" and "clients landed" reporting.
  filledAt    DateTime?
  cancelledAt DateTime?

  matches CandidateMatch[]

  @@index([clientId])
  @@index([stage])
  @@index([filledAt])
}

model Candidate {
  id             String         @id @default(cuid())
  contactId      String         @unique
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage          CandidateStage @default(SOURCED)
  skills         String?
  resumeNotes    String?        @db.Text
  resumeFilename String?
  resumeMimeType String?
  resumeData     Bytes?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  agreedPay          Float?
  payUnit            String    @default("hourly")
  education          String?
  availableFrom      DateTime?
  availabilityNote   String?
  availabilityStatus String    @default("Available")

  city  String?
  state String?

  matches CandidateMatch[]

  @@index([stage])
  @@index([availabilityStatus])
}

model CandidateMatch {
  id          String      @id @default(cuid())
  candidateId String
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status      MatchStatus @default(SUGGESTED)
  agreedPayRate Float?
  notes       String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([candidateId, jobId])
  @@index([jobId])
}

model EmailMessage {
  id                 String         @id @default(cuid())
  contactId          String?
  contact            Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  gmailMessageId     String?        @unique
  gmailThreadId      String?
  subject            String
  fromAddress        String
  toAddress          String
  cc                 String?
  bcc                String?
  snippet            String?
  body               String?        @db.Text
  bodyHtml           String?        @db.Text
  attachments        Json?
  direction          EmailDirection @default(OUTBOUND)
  folder             EmailFolder    @default(INBOX)
  isRead             Boolean        @default(true)
  isStarred          Boolean        @default(false)
  inReplyToMessageId String?
  sentAt             DateTime       @default(now())
  createdAt          DateTime       @default(now())
  syncedByUserId     String?
  syncedByUser       User?          @relation(fields: [syncedByUserId], references: [id], onDelete: SetNull)

  @@index([contactId])
  @@index([syncedByUserId, folder])
  @@index([gmailThreadId])
}

model Meeting {
  id             String    @id @default(cuid())
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title          String
  googleEventId  String?   @unique
  meetLink       String?
  scheduledStart DateTime
  scheduledEnd   DateTime?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())

  @@index([contactId])
}

model Activity {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([contactId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
